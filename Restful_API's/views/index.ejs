<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Quora Posts</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>

    <h1>Quora Posts</h1>

    <% posts.forEach((post) => { %>
        <div class="post">
            <p class="username">@<%= post.username %></p>
            <p class="content"><%= post.content %></p>

            <a href="/posts/<%= post.id %>">See in Detail</a>
            <a href="/posts/<%= post.id %>/edit">Edit</a>

            <form method="POST" action="/posts/<%= post.id %>?_method=DELETE">
                <button type="submit">Delete Posts</button>
            </form>
        </div>
    <% }); %>

    <a href="/posts/new" class="create-btn">Create new Post</a>

</body>
</html>